# Copy to .env.local and fill in.

# Image generation provider: mock (default, free, offline) | openai
IMAGE_PROVIDER=mock

# Required only when IMAGE_PROVIDER=openai. SERVER-SIDE ONLY — never ship to the client.
# If a key was ever pasted client-side or in a chat, rotate it.
OPENAI_API_KEY=
# Optional model override (default gpt-image-2)
OPENAI_IMAGE_MODEL=
